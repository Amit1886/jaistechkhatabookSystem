# Copy this file to `.env` and fill real values.
# This project auto-loads `.env` from the repo root and from Desktop data dir.

# ---------------- Core ----------------
DEBUG=True
BASE_URL=http://127.0.0.1:8080
ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_SECRET_KEY=dev-secret-key-please-change

# ---------------- Shopify (Partner App) ----------------
# Redirect URL you must add in Shopify Dev Dashboard:
#   http://127.0.0.1:8080/integrations/shopify/oauth/callback/
SHOPIFY_CLIENT_ID=your_shopify_client_id
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret
SHOPIFY_SCOPES=read_orders,read_products,read_customers

# ---------------- WhatsApp Gateway (optional) ----------------
# Used for local WhatsApp gateway integrations (if you run whatsapp_gateway service)
WA_GATEWAY_BASE_URL=http://127.0.0.1:3100
WA_GATEWAY_API_KEY=DEMO_WA_GATEWAY_KEY_CHANGE_ME

# ---------------- SMS (optional) ----------------
# You can also configure SMS from Settings Center and /settings/sms/
GOOGLE_SMS_API_KEY=
GOOGLE_SMS_SENDER_ID=
GOOGLE_SMS_API_URL=
FAST2SMS_API_KEY=

# ---------------- Email (SMTP) ----------------
# In DEBUG mode default is console backend (prints emails in server log).
# For SMTP set:
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=no-reply@example.com

